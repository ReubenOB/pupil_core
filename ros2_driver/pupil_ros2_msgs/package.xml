<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pupil_ros2_msgs</name>
  <version>0.1.0</version>
  <description>
    Custom ROS 2 message definitions for the Pupil Core eye-tracking driver.
    Provides PupilDatum (raw eye-camera detection) and GazeStamped (mapped gaze point).
  </description>
  <maintainer email="maintainer@example.com">Pupil ROS2 Driver Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
